# ---------------------------------------------------------------------------
# Who you are measuring. Required.
# ---------------------------------------------------------------------------
# BRAND_NAME is the product name as an engine would write it.
# BRAND_DOMAIN is your primary domain, no scheme.
BRAND_NAME=
BRAND_DOMAIN=

# Extra spellings the engines use for you. This matters more than it looks:
# engines are inconsistent ("Acme", "Acme AI", "acme.com"), and a mention pass
# that only checks one spelling will under-count you.
# BRAND_ALIASES=Acme AI,AcmeData

# Only if your product name is also an ordinary word. Without a hint the
# mention pass counts every casual use and the number becomes meaningless.
# BRAND_DISAMBIGUATION=The word "string" is also a common programming term - only count the product.

# Competitor domains for the weekly sitemap diff (`make competitors`).
# COMPETITORS=firecrawl.dev,brightdata.com,apify.com,oxylabs.io

# Competitor display names for the mention pass, so it can report who else
# showed up in an answer. Optional; without it the pass reports none.
# COMPETITOR_NAMES=Bright Data,Oxylabs,Zyte,Apify,Firecrawl

# ---------------------------------------------------------------------------
# Engine APIs. Provision all four in a DEDICATED org or account.
# ---------------------------------------------------------------------------
# This is not optional hygiene. Account memory and personalization bleed into
# answers, so keys attached to a personal account measure how the engines talk
# to YOU, not how they talk to a buyer. Set billing alerts while you are there.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Google surfaces. Needed for `make serp` / `make serp-core` only.
# ---------------------------------------------------------------------------
# Both Google surfaces read String's search endpoint by default:
#   POST https://request.usestring.ai/v1/search
#   engine "google_ai_mode"              -> the AI Mode answer and its sources
#   engine "google" + aiOverview: true   -> the AI Overview and its sources
# Requests ask for country US, language en. Get a key at https://usestring.ai
#
# The four engine APIs above work without it. Skip this and you lose the two
# Google surfaces, nothing else.
STRING_API_KEY=

# Override the search endpoint URL (rarely needed).
# STRING_SEARCH_URL=https://request.usestring.ai/v1/search
# Per-request timeout for the search endpoint, in ms. Default 120000.
# GOOGLE_SEARCH_TIMEOUT_MS=120000

# Set to 1 to read both Google surfaces through the hosted browser instead of
# the search endpoint. The same STRING_API_KEY drives that browser. Google
# rate-limits datacenter and office IPs quickly, so this path spends much of a
# pass on traffic challenges. Keep it for side-by-side checks.
# GOOGLE_VIA_BROWSER=1

# Browser path only: AI Mode citation scoping. 1 reads only the source links
# after the query echo; 0 (default) reads every link on the page. Both counts
# are stored on every run, so compare them before you turn this on.
# AI_MODE_SCOPE_CITATIONS=1
# Browser path only: Google folds some sources behind /goto tokens. The
# tracker resolves each token with one cookie-less GET (it reads the redirect
# Location and never loads the page). 0 turns that off.
# GOOGLE_RESOLVE_GOTO=0

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Consumer-app surfaces need no key. They authenticate through a browser
# profile in profiles/ (gitignored) created by `make setup-chatgpt`. Log in as
# a DEDICATED measurement account, turn memory OFF, and clear custom
# instructions. Both still apply inside temporary chats.

# Google Search Console. Create a "Desktop app" OAuth client in any GCP project
# with the Search Console API enabled, then run `make gsc-auth`.
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_PROPERTY=sc-domain:example.com     (defaults to your BRAND_DOMAIN)
# GSC_SITEMAPS=https://example.com/sitemap.xml

# Search feedback loop (`make search-feedback`). Queries that name your brand
# are skipped. BRAND_NAME, BRAND_DOMAIN and BRAND_ALIASES always count as
# branded; add common typos of your name here.
# SEARCH_BRANDED_TERMS=acmee,acme ai
# Words that name your category. A query served by your homepage is flagged as
# wrong intent only when it contains one of these. Unset, every non-branded
# homepage query is flagged.
# SEARCH_CATEGORY_TERMS=widget,widgets,widget api

# Your sitemap. `make competitor-posts` and `make daily-picks` mark a page "live"
# when its slug is listed here. Defaults to https://<BRAND_DOMAIN>/sitemap.xml.
# SITE_SITEMAP=https://example.com/sitemap.xml
# Optional content queue: a markdown table of planned pages, one row each as
#   | # | Draft date | Page | Kind | Slug | Bank q | Benchmark | Status |
# A Status starting "queued" marks the topic queued; any other status except
# "skipped..." marks it drafted. Unset, only the sitemap is checked.
# CONTENT_QUEUE_PATH=/path/to/content-queue.md

# Which site `make content-coverage` grades. Defaults to your BRAND_DOMAIN.
# COVERAGE_SITE=https://example.com

# Hosts `make robots-audit` checks, comma-separated, each as url=path. The
# path is where the AI crawlers must be allowed in - use a deeper path for a
# host whose root is robots-blocked by design. Defaults to your BRAND_DOMAIN
# at /. Ours, as an example:
# ROBOTS_AUDIT_HOSTS=https://usestring.ai=/,https://portal.usestring.ai=/docs

# Ordered Gemini model list: pinned model first, then fallbacks for demand
# spikes. Pin concrete models, never aliases - an alias gets re-pointed
# without notice and can 503 while the concrete model answers on the same key.
# Verify a fallback actually grounds before adding it (see README).
# GEMINI_MODELS=gemini-3.5-flash,gemini-flash-lite-latest

# DB snapshots to GitHub releases. MUST be a PRIVATE repo: release assets
# inherit repo visibility, so pointing this at a public repo publishes your
# database. Unset, `make backup` does nothing.
# BACKUP_REPO=yourorg/geo-tracker-backups
# BACKUP_KEEP=14

# Cap on how many new competitor pages get summarised per run.
# COMPETITOR_SUMMARY_CAP=40
